{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 180,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/homework-6/scripts/coverage_gate.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/homework-6/scripts/pipeline_reminder.py\""
          }
        ]
      }
    ]
  }
}
